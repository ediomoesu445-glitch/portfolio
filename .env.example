# ---------------------------------------------------------------------------
# Copy to .env.local (frontend) and backend/.env (backend), then fill in.
# Never commit the filled-in files - .gitignore already excludes them.
# This template is committed deliberately; it holds no credentials.
# ---------------------------------------------------------------------------

# --- Frontend (Next.js) ----------------------------------------------------
# Absolute site URL, used for canonical links, the sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Which API answers the contact form and the live scorer.
#   /api/py                 deployed on Vercel (same origin, no CORS)
#   http://localhost:8000   a service you are running locally
#   empty                   the Next.js route handlers in app/api/
# All three run the same rules; the site works with any of them.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# --- Backend (FastAPI) -----------------------------------------------------
ENVIRONMENT=development
DEBUG=true

# Comma-separated origins allowed to call the API. Not needed on Vercel,
# where the function is served from the site's own origin.
CORS_ORIGINS=http://localhost:3000

# Contact delivery. Leave SMTP_HOST empty in development: messages are logged
# to the console instead of being sent, so no credentials are needed.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_USE_TLS=true
CONTACT_TO_EMAIL=ediomoesu445@gmail.com
CONTACT_FROM_EMAIL=no-reply@example.com

# Max contact submissions accepted per IP per hour. Best-effort only on
# serverless, where each function instance counts separately.
CONTACT_RATE_LIMIT_PER_HOUR=5
